.superpowers/
/data/
/runs/
deploy/model*.onnx
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.obsidian/

# eval runtime state: regenerable from the test split + checkpoints; per-system CSVs and matrix.md stay tracked
results*/asr/*
# The clean test reference is report input, not disposable runtime state.
!results_r2/asr/clean.csv
results*/**/*.log
results*/*DONE
results*/**/*DONE
results*/.eval_report.lock
results*/*.partial*.csv
results*/**/spectra/

# published RIR banks (GitHub release rir-banks-2026-09-21); 1.2 GB, fetched by hash in remote_setup.sh
deploy/rir_banks/

# Exported graphs and scratch checkpoints are regenerated from local run checkpoints.
deploy/tier46/*.onnx
deploy/tier46/*.pt

# legacy checkpoints: only best.pt + run.json are tracked (what every scored row and the tier46 anchor load);
# last.pt is optimizer state for resuming, the rest is training telemetry
results_r2/runs/**/last.pt
results_r2/runs/**/events.out.tfevents.*
results_r2/runs/**/*.exit

# local-only: copies pulled off the rented training box, and personal notes
box_backup/
Claude outputs/
